(version 1)

;; ==============================================================================
;; Profil Sandboxa macOS (Seatbelt) dla Antigravity CLI / Asystenta AI
;; Wersja 4 — podejście "allow-default + deny sensitive" dla macOS 26+ (Tahoe).
;;
;; Na macOS 26 Tahoe podejście "deny default" wymaga specjalnych entitlementów
;; procesu nadrzędnego, których Terminal/VSCode nie posiada — powoduje SIGABRT.
;; Rozwiązanie: domyślnie zezwól na wszystko, jawnie zablokuj wrażliwe obszary.
;; Sandboxing skupia się na ochronie danych użytkownika przed AI.
;; ==============================================================================

;; Domyślnie zezwól na wszystko (wymagane przez macOS 26+ bez entitlementów)
(allow default)

;; Parametry przekazywane z bashowego skryptu start.sh (przez -D PROJECT_DIR=... -D USER_HOME=...)
(define project-dir (param "PROJECT_DIR"))
(define user-home   (param "USER_HOME"))

;; ==============================================================================
;; BLOKADY — wrażliwe dane i katalogi użytkownika
;; ==============================================================================

;; --- Klucze i dane uwierzytelniające ---
(deny file-read* file-write*
    (subpath (string-append user-home "/.ssh"))
    (subpath (string-append user-home "/.aws"))
    (subpath (string-append user-home "/.gnupg"))
    (subpath (string-append user-home "/Library/Keychains")))

;; --- Tokeny CLI innych usług (GitHub, Google Cloud, 1Password) ---
(deny file-read* file-write*
    (subpath (string-append user-home "/.config/gcloud"))
    (subpath (string-append user-home "/.config/gh"))
    (subpath (string-append user-home "/.config/op")))

;; --- Dane osobowe użytkownika ---
(deny file-read* file-write*
    (subpath (string-append user-home "/Documents"))
    (subpath (string-append user-home "/Downloads"))
    (subpath (string-append user-home "/Pictures"))
    (subpath (string-append user-home "/Music")))

;; --- Inne projekty na Desktopie — zablokuj Desktop jako całość... ---
(deny file-read* file-write*
    (subpath (string-append user-home "/Desktop")))

;; --- ...ale przywróć dostęp do TEGO projektu (może leżeć w ~/Desktop) ---
(allow file-read* file-write*
    (subpath project-dir))